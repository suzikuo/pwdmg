{
  "manifest_version": 3,
  "name": "My Password Autofill",
  "version": "0.2.0",
  "description": "Detect login forms and fill entries from the local My Password vault.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "tabs",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "security-core.js",
        "builtin-skins.js",
        "appearance.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "appearance.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_title": "My Password",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "show-panel": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "显示 My Password 页面弹窗"
    }
  }
}
